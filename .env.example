# ZIZ Agent — Environment Configuration
# Copy this to .env and fill in your values

# --- Database (PostgreSQL on VPS) ---
DB_HOST=postgres
DB_PORT=5432
DB_NAME=ziz_agent
DB_USER=ziz
DB_PASSWORD=change_me

# --- Telegram ---
TG_TOKEN=your_telegram_bot_token_here

# --- AI / LLM ---
NV_API_KEY=nvapi-your_nvidia_api_key
GROQ_API_KEY=gsk_your_groq_api_key

# --- WhatsApp (OpenWA on same VPS) ---
WA_URL=https://whatsappv1.abouaaliahmed.com
WA_API_KEY=your_openwa_api_key
WA_SESSION=default
WA_PHONE=+212600000000

# --- Email (SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_TO=ahmed@example.com

# --- Bot ---
API_PORT=5679
COMPANIES=ZIZPHYTOSERVICE,HB ADRAR
CURRENT_COMPANY=ZIZPHYTOSERVICE

# --- n8n Integration ---
N8N_WEBHOOK_URL=https://n8nv1.abouaaliahmed.com/webhook/telegram-ziz
